# Keep all Supabase values below from the same project.
# Public Supabase project values (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; createAdminClient() returns null when unset. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only RAWG key. Never use a NEXT_PUBLIC_ prefix.
RAWG_API_KEY=

# Optional server-only transparent logos and portrait grids. Never use a NEXT_PUBLIC_ prefix.
STEAMGRIDDB_API_KEY=
